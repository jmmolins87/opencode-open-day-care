{
  "$schema": "https://opencode.ai/config.json",
  "command": {
    "spec": {
      "description": "Crea especificaciones de pantallas y funcionalidades",
      "template": "Carga y sigue la skill spec en .agents/skills/spec/SKILL.md.\n\nFeature: $ARGUMENTS"
    },
    "spec-impl": {
      "description": "Implementa especificaciones de pantallas y funcionalidades",
      "template": "Carga y sigue la skill spec-impl en .agents/skills/spec-impl/SKILL.md.\n\nFeature: $ARGUMENTS"
    }
  },
  "permission": {
    "external_directory": {
        "/temp/**": "allow"
    },
    "bash":"allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ctx7sk-843a018e-8c5a-4629-b296-3f6b3afbd60a"
      }
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "env": {}
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/Users/juanmamc/Documentos/dashboard-nx"],
      "enabled": true,
      "env": {}
    },
    "postgresql": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres"],
      "enabled": true,
      "env": {}
    },
    "sqlite": {
      "type": "local",
      "command": ["mcp-server-sqlite", "--db", "/Users/juanmamc/Documentos/dashboard-nx/dev.db"],
      "enabled": true,
      "env": {}
    },
    "puppeteer": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-puppeteer"],
      "enabled": true,
      "env": {}
    },
    "playwright": {
      "type": "local",
      "command": ["playwright-mcp"],
      "enabled": true,
      "env": {}
    }
  }
}